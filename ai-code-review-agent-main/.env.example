# Compose-level variables (non-secret). Copy to .env and adjust as needed.
# Secrets still live only in config-server/.env and backend/.env.

DOCKERHUB_USERNAME=changeme
TAG=latest

# Change if port 80 is already taken on your machine (EC2 will use the default 80).
FRONTEND_PORT=80

# Local Docker testing default. On EC2 this becomes http://<ec2-public-ip>:8000
VITE_BACKEND_URL=http://localhost:8000

# Origins allowed to call the backend. On EC2 this becomes http://<ec2-public-ip>
ALLOWED_ORIGINS=http://localhost,http://localhost:5173
