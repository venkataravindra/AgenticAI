# Copy this file to .env and fill in your real key. Never commit .env.

# The actual secret — read locally by the backend, never fetched over HTTP.
OPENAI_API_KEY=sk-your-key-here

# Where to find the other two services
CONFIG_SERVER_URL=http://localhost:8001
MCP_SERVER_URL=http://localhost:8002

# Upload limits
MAX_UPLOAD_SIZE_MB=2
UPLOAD_DIR=uploads

# Silences a harmless ChromaDB/PostHog telemetry warning in the console
ANONYMIZED_TELEMETRY=False
